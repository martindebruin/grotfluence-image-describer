# Infisical machine identity — read by docker-compose (env_file) and used by boot.py
# to fetch the app's real secrets at container start.
#
# The real identity.env lives ONLY on the server and is gitignored: it holds a
# client secret. Never commit it.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_DOMAIN=https://app.infisical.com
